# Botkit leadgen — production env template. Copy to /usr/local/etc/botkit/leadgen.env on prod,
# chmod 600. NEVER commit real values.
METRICS_PORT=8082
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me
WEBHOOK_SECRET_TOKEN=replace-me
WEBHOOK_SECRET=replace-me
WEBHOOK_URL=https://botkit.example.com/webhook
ADMIN_PASSWORD=replace-me
ADMIN_IDS=replace-me
REDIS_PASSWORD=replace-me
REDIS_URL=redis://:replace-me@127.0.0.1:6380/1
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
DB_PATH=./data/bot.db
CRM_PROVIDER=off
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
CRM_BASE_URL=
CRM_ACCESS_TOKEN=
CRM_BITRIX_USER_ID=
CRM_BITRIX_WEBHOOK_TOKEN=
CRM_TIMEOUT_SECONDS=10
CRM_POLL_SECONDS=15
CRM_MAX_ATTEMPTS=6
CRM_BACKOFF_SECONDS=60,300,1800,7200,21600,86400
