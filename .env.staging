# =============================================================================
# botkit-leadgen — staging env for RPi4 (192.168.0.187)
# =============================================================================
# Копируйте: cp .env.staging .env   (на RPi4)
# Заполните реальные значения ниже. Файл НЕ коммитится (.env в .gitignore).
# =============================================================================

# --- Telegram (ОБЯЗАТЕЛЬНО) ---
BOT_TOKEN=replace-me            # получен у @BotFather
ADMIN_IDS=replace-me            # ваш Telegram user id (число, через запятую если несколько)

# --- CRM (для теста через /crm_test) ---
CRM_PROVIDER=generic            # generic | bitrix24 | amocrm | off
CRM_WEBHOOK_URL=http://127.0.0.1:8090/lead   # mock-CRM endpoints
CRM_WEBHOOK_SECRET=replace-me   # HMAC secret для generic webhook
CRM_BASE_URL=                   # для bitrix24/amocrm: https://portal.bitrix24.ru / https://example.amocrm.ru
CRM_ACCESS_TOKEN=               # для amocrm: Bearer токен
CRM_BITRIX_USER_ID=             # для bitrix24: id пользователя портала
CRM_BITRIX_WEBHOOK_TOKEN=       # для bitrix24: токен вебхука

# --- База / Redis ---
DB_PATH=./data/leads.db
REDIS_URL=redis://localhost:6379/0

# --- Прочее ---
ADMIN_PASSWORD=replace-me
LOG_LEVEL=INFO
METRICS_PORT=8082
ESCALATION_MINUTES=60
SENTRY_DSN=
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- CRM worker ---
CRM_TIMEOUT_SECONDS=10
CRM_POLL_SECONDS=15
CRM_MAX_ATTEMPTS=6
CRM_BACKOFF_SECONDS=60,300,1800,7200,21600,86400
